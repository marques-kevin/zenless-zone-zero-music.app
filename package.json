{
  "name": "zzz",
  "version": "1.0.0",
  "private": true,
  "description": "zzz",
  "author": "Kevin Marques",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "start": "concurrently \"yarn catalog:pull || yarn catalog:export && yarn clean && gatsby develop -H 0.0.0.0 -p 28473\" \"yarn serve:musics\"",
    "build": "NODE_ENV=production gatsby build",
    "serve": "gatsby serve",
    "serve:musics": "npx serve -p 28474",
    "sync-music": "tsx scripts/sync-music.ts",
    "ladder:stats": "tsx scripts/generate-ladder-stats.ts",
    "top-100": "tsx scripts/generate-top-liked-songs.ts",
    "most-played": "tsx scripts/generate-most-played-songs.ts",
    "clean": "gatsby clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "i18n": "tsx src/scripts/i18n.run.ts",
    "mp3": "tsx scripts/youtube-downloader/download.ts",
    "playlist": "tsx scripts/youtube-downloader/extract-playlist.ts",
    "check-zzz-playlists": "tsx scripts/youtube-downloader/check-zzz-playlists.ts",
    "sync-characters": "tsx scripts/sync-characters/sync-characters.ts",
    "deploy:firestore-rules": "tsx scripts/deploy-firestore-rules.ts",
    "ask-musics:list-pending": "tsx scripts/ask-musics/list-pending.ts",
    "ask-musics:update-status": "tsx scripts/ask-musics/update-status.ts",
    "ask-musics:process-pending": "tsx scripts/ask-musics/process-pending.ts",
    "catalog:export": "tsx scripts/catalog/export-catalog.ts",
    "catalog:pull": "tsx scripts/catalog/pull-catalog.ts",
    "catalog:bootstrap": "tsx scripts/catalog/bootstrap-catalog.ts",
    "catalog:add-track": "tsx scripts/catalog/add-track.ts",
    "catalog:update-track": "tsx scripts/catalog/update-track.ts",
    "catalog:remove-track": "tsx scripts/catalog/remove-track.ts",
    "catalog:update-playlist": "tsx scripts/catalog/update-playlist.ts"
  },
